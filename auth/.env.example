# Copy to .env (git-ignored) and set a local password. Read by docker compose and by the `dev` profile.
AUTH_DB_PASSWORD=change-me
# AUTH_DB_PORT=5433
# Public issuer; the gateway serves auth under /auth on 8080
# ISSUER_URI=http://localhost:8080/auth
# UI_BASE_URL=http://localhost:5173
# SPA_REDIRECT_URIS=http://localhost:5173/callback
# SPA_POST_LOGOUT_URIS=http://localhost:5173/
# Optional Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
