# UI_BASE_URL=http://localhost:5173
# SPA_REDIRECT_URIS=http://localhost:5173/callback
# SPA_POST_LOGOUT_URIS=http://localhost:5173/
# Optional Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
