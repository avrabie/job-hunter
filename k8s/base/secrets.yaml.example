# Template only. Copy to secrets.yaml (git-ignored), replace every CHANGE_ME with a long random value, then:
#   kubectl apply -f k8s/base/secrets.yaml
# Generate a value with:  openssl rand -base64 24 | tr -d '/+=' 
apiVersion: v1
kind: Secret
metadata:
  name: job-hunter-secrets
  namespace: job-hunter
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME   # PostgreSQL superuser, used only by the postgres container itself
  AUTH_DB_PASSWORD: CHANGE_ME    # role `auth` on database `authdb`
  BACKEND_DB_PASSWORD: CHANGE_ME # role `backend` on database `jobhunter`
